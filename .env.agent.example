MANAGER_URL=http://localhost:8080

# Use the manager's API_KEY_AGENT value here — never the readonly or admin key
API_KEY=

# Comma-separated; the agent only ever learns about domains it's configured for
DOMAINS=

POLL_INTERVAL_SECONDS=60

INSTALL_DIR=/etc/cds-agent/certs

NGINX_RELOAD_CMD=nginx -s reload

# Only needed if the manager requires mTLS
TLS_CLIENT_CERT=

TLS_CLIENT_KEY=

# Only needed if the manager's TLS certificate isn't from a public CA
TLS_CA=
