PORT=8080

LOG_LEVEL=info

ACME_FILE=/data/acme.json

EXPORT_DIR=/data/export

CERT_EXPIRY_WARN_DAYS=30

# Leave both blank to disable the API entirely (it fails closed, not open)
API_KEY_READONLY=

API_KEY_ADMIN=

# Separate, least-privilege key for Certificate Agents — bundle download only
API_KEY_AGENT=

# Leave blank to serve plain HTTP (e.g. local dev, or behind an external TLS terminator)
TLS_CERT=

TLS_KEY=

# Leave blank to skip client certificate verification (plain server-side TLS, not mTLS)
TLS_CLIENT_CA=
